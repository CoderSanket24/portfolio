# Environment Variables Example
# Copy this file to .env.local for local development
# Copy to .env.production for production builds

# API URLs (if needed)
# VITE_API_URL=https://api.yourdomain.com

# Analytics (optional)
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_ANALYTICS_ID=your-analytics-id

# Contact Form (if you add one)
# VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Social Media
VITE_GITHUB_URL=https://github.com/sanketbotre
VITE_LINKEDIN_URL=https://linkedin.com/in/sanket-botre
VITE_EMAIL=sanketbotre2004@gmail.com

# Feature Flags (optional)
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_CONTACT_FORM=true
